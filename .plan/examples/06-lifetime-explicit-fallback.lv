// ============================================================
// 06-lifetime-explicit-fallback.lv
// 展示：生命周期自动推断失败时的显式标注兜底
// 关联决策：DD-002 (lifetime-inference)
// 未决语法：显式标注的最终语法见 OQ-007，本文件语法为临时提案，
//           用于纸面验证可读性，正式语法定稿后需回来修订本文件
// ============================================================

// --- 场景1：第一级规则足够，无需任何标注 ---
// 结构体字段引用，自动生成生命周期（规则A）
struct Wrapper {
    inner: &str,
}

// 单一输入生命周期，自动应用到输出（Rust Rule 2 的等价物）
function first_word(s: &str) -> &str {
    return s.split(' ').first();
}

// --- 场景2：私有函数，第二级函数体流分析生效，无需标注 ---
function pick_one(a: &str, b: &str, use_first: bool) -> &str {
    if use_first {
        return a;
    } else {
        return b;
    }
}
// 编译器通过分析两条return路径，确定返回值分别来自a或b，
// 自动推断：a和b必须共享同一生命周期约束

// --- 场景3：pub函数 + 多参数歧义，自动推断失败，需要显式标注 ---
//
// TODO(OQ-007): 以下标注语法为临时提案，待正式语法定稿后修订。
// 提案A（Rust风格）：<'a>
// 提案B（Region谓词风格）：where region(a) == region(b)
// 本文件暂时展示提案A，因其与Rust生态的迁移成本最低

pub function longest<'a>(a: &'a str, b: &'a str) -> &'a str {
    if a.len() > b.len() {
        return a;
    } else {
        return b;
    }
}

// 若不标注会得到类似以下的编译器诊断（目标体验，非最终文案）：
//
// error: 无法推断返回值的生命周期来源
//   --> 06-lifetime-explicit-fallback.lv:XX:1
//    |
// XX | pub function longest(a: &str, b: &str) -> &str {
//    |
// 提示：此函数为 pub，签名必须自洽，不能依赖函数体分析。
//       返回值可能来自 `a` 或 `b`，取决于运行时条件。
// 建议标注：
//   pub function longest<'a>(a: &'a str, b: &'a str) -> &'a str { ... }

// --- 场景4：输入生命周期确实不同，需要分别标注 ---
pub function select_primary<'a, 'b>(primary: &'a str, fallback: &'b str, use_primary: bool) -> &'a str {
    // 注意：此签名约定返回值固定关联 primary 的生命周期，
    // 因此函数体内部只能返回 primary（若尝试返回fallback会在函数体内报错）
    if use_primary {
        return primary;
    } else {
        return primary;  // 必须返回与签名声明一致的生命周期来源
    }
}

function main() {
    let s = String::from("hello world");
    println("{}", first_word(&s));

    let a = "short";
    let b = "longer string";
    println("{}", pick_one(a, b, true));
    println("{}", longest(a, b));
}