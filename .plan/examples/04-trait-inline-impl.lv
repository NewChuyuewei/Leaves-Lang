// ============================================================
// 04-trait-inline-impl.lv
// 展示：trait定义、内联impl、独立impl混用、约束内联、
//       given逃生舱、关联类型复用泛型语法、multi标注、dyn
// 关联决策：DD-004 (trait-generics-syntax)
// 未决语法：given块具体格式见 OQ-001，这里采用临时语法
// ============================================================

trait Printable {
    function print(&self);
}

trait Comparable<T> {
    function compare(&self, other: &T) -> Ordering;
}

// --- 内联impl：写在struct定义内部 ---
struct Point {
    x: f64,
    y: f64,

    impl Printable {
        function print(&self) {
            println("({}, {})", self.x, self.y);
        }
    }
}

// --- 独立impl：与内联impl可在同一类型上混用 ---
// （编译器会给出非强制 lint 提示，建议风格统一）
impl Comparable<Point> for Point {
    function compare(&self, other: &Point) -> Ordering {
        let m1 = (self.x * self.x + self.y * self.y).sqrt();
        let m2 = (other.x * other.x + other.y * other.y).sqrt();
        return m1.compare(&m2);
    }
}

// --- 泛型约束内联（取消 where）---
function process<T: Clone + Printable, U: Into<T> + Send>(x: T, y: U) -> T {
    x.print();
    return x.clone();
}

// 约束较长时，结构化换行
function process_many<
    T: Clone + Printable,
    U: Into<T> + Send + Sync,
>(items: Vec<T>, extra: U) -> Vec<T> {
    for item in &items {
        item.print();
    }
    return items;
}

// --- given 逃生舱：复杂双向依赖约束 ---
// TODO(OQ-001): given块具体分隔符/嵌套规则待定，此处为临时语法
function complex<T, U>(x: T, y: U) -> T
given {
    T: Comparable<U>,
    U: Comparable<T>,
}
{
    return x;
}

// --- 关联类型复用泛型参数语法 ---
trait Container<Item> {
    function get(&self, i: usize) -> Item;
}

struct MyVec {
    data: Vec<i32>,

    impl Container<i32> {   // 默认：唯一实现
        function get(&self, i: usize) -> i32 {
            return self.data[i];
        }
    }
}

// --- multi 标注：解除唯一实现限制（对应 From<T> 场景）---
trait From<Source: multi> {
    function from(source: Source) -> Self;
}

struct Celsius {
    value: f64,

    impl From<f64> {
        function from(source: f64) -> Celsius {
            return Celsius { value: source };
        }
    }

    impl From<i32> {   // multi 标注后，允许对同一类型多次实现
        function from(source: i32) -> Celsius {
            return Celsius { value: source as f64 };
        }
    }
}

// --- trait对象：静态分发 vs 动态分发，显式标注 ---
function print_static<T: Printable>(item: T) {
    item.print();   // 单态化，零成本
}

function print_dynamic(item: dyn Printable) {
    item.print();   // 动态分发，显式dyn标注，告知有vtable开销
}

function main() {
    let p = Point { x: 3.0, y: 4.0 };
    p.print();

    let items: Vec<Box<dyn Printable>> = vec![
        Box::new(Point { x: 1.0, y: 1.0 }),
        Box::new(Point { x: 2.0, y: 2.0 }),
    ];
    for item in &items {
        print_dynamic(*item);
    }

    let c: Celsius = Celsius::from(100.0);
    let c2: Celsius = Celsius::from(37);
}