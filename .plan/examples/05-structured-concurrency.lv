// ============================================================
// 05-structured-concurrency.lv
// 展示：sprout、grove::scope、channel所有权转移、
//       级联取消、spawn_detached
// 关联决策：DD-007 (concurrency-model) [状态: Provisional]
// ============================================================

struct User {
    id: u64,
    name: String,
}

// 没有 async/await 关键字，看起来像普通同步函数
// 底层由有栈协程(sprout)在协作式调度下运行，不阻塞线程
function fetch_user(id: u64) -> User {
    let data = http::get(format!("/users/{}", id));
    return User::parse(data);
}

// --- 基础用法：独立sprout任务 ---
function basic_sprout_demo() {
    let handle = sprout { fetch_user(42) };
    let user = handle.join();
    println("fetched user: {}", user.name);
}

// --- 结构化并发：scope 同时是并发边界和 Region 边界 ---
function structured_scope_demo() {
    let data = vec![1, 2, 3];

    grove::scope(|s| {
        // 多个sprout可同时借用外层数据，
        // 编译器把scope视为一个region来验证借用安全性
        s.sprout(|| {
            println("task A sees: {:?}", data);
        });
        s.sprout(|| {
            println("task B sees: {:?}", data);
        });
    });  // scope退出时自动等待所有子sprout完成

    println("all tasks done, data still owned here: {:?}", data);
}

// --- 级联取消：子任务panic时，兄弟任务自动取消 ---
function cascading_cancellation_demo() {
    let result = grove::scope(|s| {
        s.sprout(|| {
            long_running_task();  // 若兄弟任务panic，此任务会被自动取消
        });
        s.sprout(|| {
            might_panic();
        });
    });

    match result {
        Ok(_) => println("all tasks completed successfully"),
        Err(e) => println("scope failed, cascaded cancellation triggered: {}", e),
    }
}

function long_running_task() {
    // 模拟长时间运行的任务
    for i in 0..1000000 {
        // 协作式让出点
    }
}

function might_panic() {
    panic("simulated failure");
}

// --- Channel：所有权转移语义，编译期杜绝数据竞争 ---
function channel_demo() {
    let (tx, rx) = channel::<Vec<i32>>();

    let data = vec![1, 2, 3];
    tx.send(data);
    // data.push(4);  // ❌ 编译错误：data 的所有权已转移给 channel

    grove::scope(|s| {
        s.sprout(|| {
            let received = rx.recv();
            println("received: {:?}", received);
        });
    });
}

// --- spawn_detached：显式脱离结构化作用域（有意为之的后台任务）---
function detached_demo() {
    grove::spawn_detached(|| {
        background_log_flush();
    });
    // 注意：此任务不受当前作用域生命周期约束，
    // 调用者需要自行保证其正确性（命名刻意带有警示性）
}

function background_log_flush() {
    println("flushing logs in background...");
}

function main() {
    basic_sprout_demo();
    structured_scope_demo();
    cascading_cancellation_demo();
    channel_demo();
    detached_demo();
}