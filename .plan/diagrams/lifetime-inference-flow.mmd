%% 关联决策: DD-002 (lifetime-inference)
%% 说明: 展示生命周期推断的两级判定流程

flowchart TD
    Start["函数定义"] --> CheckVis{"可见性?"}

    CheckVis -->|"pub"| PubPath["仅第一级规则生效<br/>(签名自洽)"]
    CheckVis -->|"私有/内部"| PrivPath["第一级规则 +<br/>第二级函数体分析"]

    PubPath --> Rule1{"签名能否通过<br/>扩展省略规则推断?<br/>(规则A: 结构体字段<br/>规则2/3: Rust原有规则)"}
    Rule1 -->|"是"| Success1["✅ 自动推断成功<br/>无需标注"]
    Rule1 -->|"否"| NeedAnnotation["需要显式标注<br/>(语法见 OQ-007)"]

    PrivPath --> Rule1b{"签名层面<br/>能否推断?"}
    Rule1b -->|"是"| Success2["✅ 推断成功"]
    Rule1b -->|"否"| BodyAnalysis["启用借用溯源分析<br/>(Borrow Provenance Analysis)"]

    BodyAnalysis --> TraceReturns["遍历所有return路径<br/>追踪借用来源"]
    TraceReturns --> CheckConsistent{"来源是否<br/>可统一?"}

    CheckConsistent -->|"是"| Success3["✅ 自动生成<br/>生命周期约束"]
    CheckConsistent -->|"否，存在冲突"| ReportConflict["编译期报错<br/>指出具体冲突路径"]

    NeedAnnotation --> UserAnnotates["开发者添加标注"]
    ReportConflict --> UserAnnotates
    UserAnnotates --> Recheck["重新验证"]

    style Success1 fill:#ccffcc
    style Success2 fill:#ccffcc
    style Success3 fill:#ccffcc
    style ReportConflict fill:#ffcccc
    style NeedAnnotation fill:#fff4cc
    style BodyAnalysis fill:#e6f3ff