%% 关联决策: DD-003, DD-007
%% 说明: 展示 Leaves 最核心的创新 —— Scope 同时是并发边界和 Region 边界
%%       对应 examples/05-structured-concurrency.lv 中的 scope 示例

flowchart TD
    subgraph OuterScope["外层作用域"]
        Data["let data = vec![1,2,3]<br/>(栈上数据)"]

        subgraph GroveScope["grove::scope(|s| {...})<br/>= 并发边界 = Region边界"]
            direction LR
            SproutA["s.sprout(A)<br/>借用 &data"]
            SproutB["s.sprout(B)<br/>借用 &data"]
        end

        Data -.->|"借用检查器<br/>视为同一Region"| GroveScope
        GroveScope -->|"scope退出时<br/>自动join所有sprout"| AfterScope["data 可继续使用<br/>或被释放"]
    end

    PanicB["若 SproutB panic"] -.->|"级联取消"| SproutA
    PanicB -.->|"错误向上传播"| GroveScope

    style GroveScope fill:#e6ffe6,stroke:#009900,stroke-width:2px
    style PanicB fill:#ffcccc,stroke:#cc0000

    Note1["核心洞察: 子sprout对外层数据的借用<br/>天然满足'内层不长于外层'的Region嵌套规则(DD-003)<br/>无需为并发场景设计额外借用检查逻辑"]

    style Note1 fill:#f0f0f0,stroke:#999999

    %% 补充图：对比 Rust Future模型 vs Leaves 有栈协程模型

flowchart LR
    subgraph RustModel["Rust: Future/Poll 状态机"]
        direction TB
        RA["async fn"] --> RB["编译为状态机"]
        RB --> RC["跨await点的借用<br/>产生自引用结构"]
        RC --> RD["需要 Pin/Unpin"]
        RB --> RE["独立Future类型"]
        RE --> RF["函数彩色问题<br/>sync/async不兼容"]
    end

    subgraph LeavesModel["Leaves: 有栈协程(sprout)"]
        direction TB
        LA["普通function"] --> LB["sprout包裹<br/>运行时协作调度"]
        LB --> LC["独立栈空间<br/>无状态机生成"]
        LC --> LD["✅ 无Pin/Unpin"]
        LB --> LE["与普通函数同类型"]
        LE --> LF["✅ 同步异步自由互调"]
    end

    style RD fill:#ffcccc
    style RF fill:#ffcccc
    style LD fill:#ccffcc
    style LF fill:#ccffcc