-- Run with leav; every workload checks its result before reporting CPU time.
local n = tonumber(arg[1]) or 200000
assert(n > 0 and n % 1 == 0)
local function bench(name, f)
  collectgarbage('collect')
  local start = os.clock()
  f()
  print(string.format('%s %.9f', name, os.clock() - start))
end

class Empty end
class Base
  function init(value) self.value = value end
  function get() return self.value end
  static function kind() return 'base' end
end
class Child extends Base end
class Grandchild extends Child end
local Deep = Base
for i = 1, 32 do
  class Layer extends Deep end
  Deep = Layer
end

bench('construct_empty', function()
  for i = 1, n do assert(leaves.typeof(Empty()) == Empty) end
end)
bench('construct_own', function()
  for i = 1, n do assert(Base(i).value == i) end
end)
bench('construct_inherited', function()
  for i = 1, n do assert(Grandchild(i).value == i) end
end)
bench('construct_deep', function()
  for i = 1, math.max(1, math.floor(n / 10)) do
    assert(Deep(i).value == i)
  end
end)
bench('method_dispatch', function()
  local o, sum = Grandchild(3), 0
  for i = 1, n do sum = sum + o:get() end
  assert(sum == n * 3)
end)
bench('static_lookup', function()
  for i = 1, n do assert(Grandchild.kind() == 'base') end
end)
bench('plain_lua', function()
  local t, sum = {}, 0
  for i = 1, n do t[i] = i; sum = sum + t[i] end
  assert(sum == n * (n + 1) / 2)
end)
